      "name": "One Item Per Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.patient_email}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "4",
      "name": "Has Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        180,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.MAIL_DEFAULT_SENDER}}",
        "toEmail": "={{$json.patient_email}}",
        "subject": "Appointment reminder - 24 hours",
        "text": "=Hello {{$json.patient_name || 'Patient'}},\\n\\nThis is a reminder for your appointment.\\nDoctor: {{$json.doctor_name}}\\nDate: {{$json.date}}\\nTime: {{$json.start_time}}\\n\\nPlease sign in to the clinic website if you need to manage your appointment.",
        "options": {}
      },
      "id": "5",
      "name": "Send Reminder Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        420,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CLINIC_BASE_URL}}/api/integration/reminders/{{$json.id}}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-Key",
              "value": "={{$env.N8N_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "6",
      "name": "Mark Reminder Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
