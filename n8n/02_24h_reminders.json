        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-Key",
              "value": "={{$env.N8N_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Get Due Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return ($json.appointments||[]).map(a=>({json:a}));"
      },
